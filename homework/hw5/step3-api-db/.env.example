# 複製成 .env 後修改：cp .env.example .env
# UID/GID 用 `id -u` 和 `id -g` 查，填你主機帳號的值
USER_UID=1000
USER_GID=1000

# 容器和主機必須相同，否則看不到彼此的 topic
ROS_DOMAIN_ID=0

# 第 3 步：PostgreSQL
# 注意：資料庫第一次建立後再改這裡「不會生效」，要 docker compose down -v 重建
POSTGRES_USER=amr
POSTGRES_PASSWORD=amr_dev_pw
POSTGRES_DB=amr

# API 記錄位置用的 topic（跑 AMCL 時可改成 /amcl_pose + geometry_msgs/msg/PoseWithCovarianceStamped）
POSE_TOPIC=/odom
POSE_TYPE=nav_msgs/msg/Odometry
